<?xml version="1.0" encoding="UTF-8" ?>
<!-- Desktop-side FastDDS config for Tailscale VPN.
     Keeps builtin transports so local ros2 CLI commands work normally.
     Adds gopiros2 as an explicit unicast peer so discovery crosses the VPN. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <participant profile_name="default_profile" is_default_profile="true">
    <rtps>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>100.75.56.5</address>  <!-- gopiros2 Tailscale IP -->
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>

</profiles>
