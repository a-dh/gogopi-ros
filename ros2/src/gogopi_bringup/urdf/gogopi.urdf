<?xml version="1.0"?>
<robot name="gogopi">

  <!-- Dummy root required by KDL — base_link cannot carry inertia as root -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base link (body) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0155" rpy="0 0 0"/>
      <geometry>
        <box size="0.133 0.095 0.031"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0155" rpy="0 0 0"/>
      <geometry>
        <box size="0.133 0.095 0.031"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Wheels -->
  <link name="wheel_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0335" length="0.021"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0335" length="0.021"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="wheel_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0335" length="0.021"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0335" length="0.021"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Castor -->
  <link name="castor_link">
    <visual>
      <geometry>
        <sphere radius="0.007"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0.01675" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.011" length="0.0195"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.007"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- Sensor tower -->
  <link name="sensor_tower">
    <visual>
      <origin xyz="0 0 0.0445" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.055 0.089"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.013 0 0.0905" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.030 0.003"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0445" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.055 0.089"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Pan link -->
  <link name="pan_link">
    <visual>
      <geometry>
        <cylinder radius="0.021" length="0.005"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.021" length="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Tilt link -->
  <link name="tilt_link">
    <visual>
      <geometry>
        <box size="0.036 0.040 0.013"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.036 0.040 0.013"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Camera links -->
  <link name="camera_link">
    <!-- Circuit board on left side of tilt unit: 2mm thick(x) x 25mm wide(y) x 30mm tall(z) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.025 0.030"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1.0"/>
      </material>
    </visual>
    <!-- 18mm diameter lens cylinder pointing forward, centered on board -->
    <visual>
      <origin xyz="0.0085 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.015"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.017 0.025 0.030"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="thermal_camera_link">
    <!-- Circuit board on front face of tilt unit: 2mm thick(x) x 15mm wide(y) x 26mm tall(z) -->
    <visual>
      <origin xyz="-0.001 0 -0.013" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.015 0.026"/>
      </geometry>
      <material name="purple">
        <color rgba="0.5 0.2 0.5 1.0"/>
      </material>
    </visual>
    <!-- 10mm diameter lens cylinder pointing forward, centered at top of board -->
    <visual>
      <origin xyz="0.005 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.010"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.012 0.015 0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Lidar -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.040" length="0.015"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.040" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Joints -->
  <!-- Wheels -->
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.0295 0.060 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.0295 -0.060 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Castor -->
  <joint name="castor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="castor_link"/>
    <origin xyz="-0.0545 0 -0.0265" rpy="0 0 0"/>
  </joint>

  <!-- Sensor tower -->
  <joint name="sensor_tower_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_tower"/>
    <origin xyz="-0.0475 0 0.031" rpy="0 0 0"/>
  </joint>

  <!-- Pan joint (servo 2) -->
  <joint name="pan_joint" type="revolute">
    <parent link="sensor_tower"/>
    <child link="pan_link"/>
    <origin xyz="0.026 0 0.092" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- Tilt joint (servo 1) -->
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="-0.012 0 0.0235" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- Cameras -->
  <!-- camera_link origin = board center on front face of tilt unit, left half -->
  <joint name="camera_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.019 0.0075 0" rpy="0 0 0"/>
  </joint>

  <!-- thermal_camera_link origin = lens center at top of board on front face, right half -->
  <joint name="thermal_camera_joint" type="fixed">
    <parent link="tilt_link"/>
    <child link="thermal_camera_link"/>
    <origin xyz="0.020 -0.0125 0.013" rpy="0 0 0"/>
  </joint>

  <!-- Lidar: spinner centre at wheel-axis x, robot centreline y, 130 mm above floor -->
  <!-- floor = wheel_centre_z − wheel_radius = 0 − 0.0335 = −0.0335 m in base_link  -->
  <!-- lidar z = −0.0335 + 0.130 = 0.0965 m                                          -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0295 0 0.0965" rpy="0 0 0"/>
  </joint>

</robot>